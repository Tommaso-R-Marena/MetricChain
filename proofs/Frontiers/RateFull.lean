import Mathlib
import proofs.Frontiers.BoundedAccuracy


namespace ScienceR13

/-- `κ = h² a/((a − h)(a + h)(2a − h))`. -/
noncomputable def kappa (a h : ℝ) : ℝ := h ^ 2 * a / ((a - h) * (a + h) * (2 * a - h))

/-- `c₁ = h (1 + κ)/κ`. -/
noncomputable def c1 (a h : ℝ) : ℝ := h * (1 + kappa a h) / kappa a h

/-- `c₂ = (a + h)(2a − h)/(h a) − 2`. -/
noncomputable def c2 (a h : ℝ) : ℝ := (a + h) * (2 * a - h) / (h * a) - 2

theorem kappa_pos {a h : ℝ} (hh : 0 < h) (hah : h < a) : 0 < kappa a h := by
  unfold kappa
  have h1 : 0 < a - h := by linarith
  have h2 : 0 < a + h := by linarith
  have h3 : 0 < 2 * a - h := by linarith
  have ha : 0 < a := by linarith
  positivity

/-- `κ < d₀ = h/(a − h)`; equivalently `c₂ + 1 > 0`. -/
theorem kappa_lt_d0 {a h : ℝ} (hh : 0 < h) (hah : h < a) : kappa a h < h / (a - h) := by
  unfold kappa
  have h1 : 0 < a - h := by linarith
  have h2 : 0 < a + h := by linarith
  have h3 : 0 < 2 * a - h := by linarith
  have ha : 0 < a := by linarith
  rw [div_lt_div_iff₀ (by positivity) h1]
  nlinarith [mul_pos hh h1, mul_pos (mul_pos hh h1) (mul_pos ha ha), mul_pos (mul_pos hh h1) (mul_pos hh hh),
    mul_pos (mul_pos hh h1) (mul_pos ha (sub_pos.mpr hah))]

/-- `c₂ = d₀/κ − 2`. -/
theorem c2_eq {a h : ℝ} (hh : 0 < h) (hah : h < a) : c2 a h = h / (a - h) / kappa a h - 2 := by
  unfold c2 kappa
  have h1 : a - h ≠ 0 := by linarith
  have h2 : a + h ≠ 0 := by linarith
  have h3 : 2 * a - h ≠ 0 := by linarith
  have ha : a ≠ 0 := by linarith
  have hh' : h ≠ 0 := hh.ne'
  field_simp

/-- The polynomial inequality behind "the gain per level is at least `κ`": `h f(d) ≥ h f(d₀)` for `d ≥ d₀`. -/
theorem gain_poly {a h d : ℝ} (hh : 0 < h) (hah : h < a) (hd : h ≤ d * (a - h)) :
    (d + 2) * (d * (a - h) + a) * (h * a) ≤ d * (1 + d) * ((a - h) * (a + h) * (2 * a - h)) := by
  have h1 : 0 < a - h := by linarith
  have ha : 0 < a := by linarith
  have hd0 : 0 < d := by
    by_contra hcon
    rw [not_lt] at hcon
    nlinarith
  have hid : (a - h) * (d * (1 + d) * ((a - h) * (a + h) * (2 * a - h)) - (d + 2) * (d * (a - h) + a) * (h * a))
      = (d * (a - h) - h) * ((2 * a ^ 2 - h ^ 2) * d * (a - h) + 2 * (a - h) * a ^ 2) := by ring
  have hA : 0 < 2 * a ^ 2 - h ^ 2 := by nlinarith
  have hrhs : 0 ≤ (d * (a - h) - h) * ((2 * a ^ 2 - h ^ 2) * d * (a - h) + 2 * (a - h) * a ^ 2) := by
    apply mul_nonneg (by linarith)
    have : 0 < (2 * a ^ 2 - h ^ 2) * d * (a - h) := by positivity
    have : 0 < 2 * (a - h) * a ^ 2 := by positivity
    linarith
  rw [← hid] at hrhs
  have := nonneg_of_mul_nonneg_right hrhs h1
  linarith

/-- **One epoch.**  With `d ≥ d₀ = h/(a − h)` and `d ≤ J < d + 1`: the denominator is positive and
`d' − d ≥ (J + 1) κ` for `d' = d (J a + h)/(J a − h d)`. -/
theorem epoch_gain {a h d J : ℝ} (hh : 0 < h) (hah : h < a) (hd : h / (a - h) ≤ d) (hJ1 : d ≤ J) (hJ2 : J < d + 1) :
    0 < J * a - h * d ∧ (J + 1) * kappa a h ≤ d * (J * a + h) / (J * a - h * d) - d := by
  have h1 : 0 < a - h := by linarith
  have h2 : 0 < a + h := by linarith
  have h3 : 0 < 2 * a - h := by linarith
  have ha : 0 < a := by linarith
  have hd' : h ≤ d * (a - h) := by
    rw [div_le_iff₀ h1] at hd
    exact hd
  have hd0 : 0 < d := lt_of_lt_of_le (div_pos hh h1) hd
  have hden : 0 < J * a - h * d := by nlinarith
  refine ⟨hden, ?_⟩
  have hgain : d * (J * a + h) / (J * a - h * d) - d = d * h * (1 + d) / (J * a - h * d) := by
    have hne : J * a - h * d ≠ 0 := hden.ne'
    rw [eq_div_iff hne, sub_mul, div_mul_cancel₀ _ hne]
    ring
  rw [hgain, le_div_iff₀ hden]
  have hκ := kappa_pos hh hah
  have hD : 0 < (a - h) * (a + h) * (2 * a - h) := by positivity
  -- (J + 1) (J a − h d) ≤ (d + 2) (d (a − h) + a)
  have hprod : (J + 1) * (J * a - h * d) ≤ (d + 2) * (d * (a - h) + a) := by
    have e1 : J + 1 ≤ d + 2 := by linarith
    have e2 : J * a - h * d ≤ d * (a - h) + a := by nlinarith
    have e3 : 0 ≤ J + 1 := by linarith
    have e4 : 0 ≤ d * (a - h) + a := by positivity
    calc (J + 1) * (J * a - h * d) ≤ (J + 1) * (d * (a - h) + a) := mul_le_mul_of_nonneg_left e2 e3
      _ ≤ (d + 2) * (d * (a - h) + a) := mul_le_mul_of_nonneg_right e1 e4
  have hpoly := gain_poly hh hah hd'
  -- κ (d + 2)(d (a − h) + a) ≤ d h (1 + d)
  have hκle : kappa a h * ((d + 2) * (d * (a - h) + a)) ≤ d * h * (1 + d) := by
    unfold kappa
    rw [div_mul_eq_mul_div, div_le_iff₀ hD]
    nlinarith
  calc (J + 1) * kappa a h * (J * a - h * d) = kappa a h * ((J + 1) * (J * a - h * d)) := by ring
    _ ≤ kappa a h * ((d + 2) * (d * (a - h) + a)) := mul_le_mul_of_nonneg_left hprod hκ.le
    _ ≤ d * h * (1 + d) := hκle

/-- **The closed form dominates the epoch recursion.** -/
theorem closed_form {a h : ℝ} (hh : 0 < h) (hah : h < a) (d : ℕ → ℝ) (k J : ℕ → ℕ)
    (hd0 : d 0 = h / (a - h)) (hk0 : k 0 = 1)
    (hJ : ∀ m, d m ≤ J m ∧ (J m : ℝ) < d m + 1)
    (hd : ∀ m, d (m + 1) = d m * (J m * a + h) / (J m * a - h * d m))
    (hk : ∀ m, k (m + 1) = k m + J m + 1) :
    ∀ m n : ℕ, k m ≤ n → n < k (m + 1) → h / d m ≤ c1 a h / (n + c2 a h) := by
  have h1 : 0 < a - h := by linarith
  have hκ := kappa_pos hh hah
  have hκd := kappa_lt_d0 hh hah
  have hd0pos : 0 < h / (a - h) := div_pos hh h1
  -- d_m ≥ d_0 + κ (k_m − 1)
  have hlin : ∀ m, h / (a - h) ≤ d m ∧ h / (a - h) + kappa a h * ((k m : ℝ) - 1) ≤ d m := by
    intro m
    induction m with
    | zero =>
      rw [hd0, hk0]
      constructor
      · exact le_rfl
      · simp
    | succ m ih =>
      obtain ⟨ih1, ih2⟩ := ih
      obtain ⟨_, hg⟩ := epoch_gain hh hah ih1 (hJ m).1 (hJ m).2
      rw [← hd m] at hg
      have hJ0 : (0 : ℝ) ≤ J m := Nat.cast_nonneg _
      have hk' : ((k (m + 1) : ℕ) : ℝ) = (k m : ℝ) + (J m : ℝ) + 1 := by
        rw [hk m]; push_cast; ring
      constructor
      · nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ (J m : ℝ) + 1) hκ.le]
      · rw [hk']
        nlinarith
  intro m n hmn hnk
  obtain ⟨hm1, hm2⟩ := hlin m
  have hdm : 0 < d m := lt_of_lt_of_le hd0pos hm1
  -- n ≤ k_m + J_m < k_m + d_m + 1
  have hn1 : (n : ℝ) ≤ (k m : ℝ) + (J m : ℝ) := by
    have : n ≤ k m + J m := by
      rw [hk m] at hnk
      omega
    exact_mod_cast this
  have hn2 : (n : ℝ) - (k m : ℝ) - 1 < d m := by linarith [(hJ m).2]
  have hkey : kappa a h * ((n : ℝ) - 2) + h / (a - h) ≤ (1 + kappa a h) * d m := by
    nlinarith
  -- positivity of the denominator: n ≥ 1
  have hk1 : ∀ m, 1 ≤ k m := by
    intro m
    induction m with
    | zero => rw [hk0]
    | succ m ih => rw [hk m]; omega
  have hn0 : (1 : ℝ) ≤ n := by
    have : 1 ≤ n := le_trans (hk1 m) hmn
    exact_mod_cast this
  have hpos : 0 < kappa a h * ((n : ℝ) - 2) + h / (a - h) := by nlinarith
  have hden : (n : ℝ) + c2 a h = (kappa a h * ((n : ℝ) - 2) + h / (a - h)) / kappa a h := by
    rw [c2_eq hh hah]
    field_simp
    ring
  have hrw : c1 a h / ((n : ℝ) + c2 a h) = h * (1 + kappa a h) / (kappa a h * ((n : ℝ) - 2) + h / (a - h)) := by
    rw [hden]
    unfold c1
    field_simp
  rw [hrw, div_le_div_iff₀ hdm hpos]
  nlinarith

/-- The sequences of statement (a), built with `J = ⌈d⌉`. -/
noncomputable def epochSeq (a h : ℝ) : ℕ → ℝ × ℕ
  | 0 => (h / (a - h), 1)
  | m + 1 =>
    let p := epochSeq a h m
    (p.1 * ((⌈p.1⌉₊ : ℝ) * a + h) / ((⌈p.1⌉₊ : ℝ) * a - h * p.1), p.2 + ⌈p.1⌉₊ + 1)

/-- **From the epoch property to the rate.**  `P n b` is read "`b` is an upper bound at level `n`". -/
theorem rate_of_epochs {a h : ℝ} (hh : 0 < h) (hah : h < a) (P : ℕ → ℝ → Prop)
    (hstep : ∀ n b, 1 ≤ n → P n b → P (n + 1) b)
    (hweak : ∀ n b b', P n b → b ≤ b' → P n b')
    (hP1 : P 1 a)
    (hep : ∀ (n : ℕ) (b : ℝ), 1 ≤ n → P n b → h < b →
      P (n + ⌈h / (b - h)⌉₊ + 1) (b * ((⌈h / (b - h)⌉₊ : ℝ) * a) / ((⌈h / (b - h)⌉₊ : ℝ) * a + h))) :
    ∀ n : ℕ, 1 ≤ n → P n (h + c1 a h / (n + c2 a h)) := by
  have h1 : 0 < a - h := by linarith
  have ha : 0 < a := by linarith
  set d : ℕ → ℝ := fun m => (epochSeq a h m).1 with hddef
  set k : ℕ → ℕ := fun m => (epochSeq a h m).2 with hkdef
  set J : ℕ → ℕ := fun m => ⌈d m⌉₊ with hJdef
  have hd0 : d 0 = h / (a - h) := rfl
  have hk0 : k 0 = 1 := rfl
  have hdS : ∀ m, d (m + 1) = d m * (J m * a + h) / (J m * a - h * d m) := fun m => rfl
  have hkS : ∀ m, k (m + 1) = k m + J m + 1 := fun m => rfl
  -- d_m ≥ d_0 > 0, hence the ceiling property
  have hdge : ∀ m, h / (a - h) ≤ d m := by
    intro m
    induction m with
    | zero => exact le_of_eq hd0.symm
    | succ m ih =>
      have hd0pos : 0 < h / (a - h) := div_pos hh h1
      have hJm : d m ≤ J m ∧ (J m : ℝ) < d m + 1 :=
        ⟨Nat.le_ceil _, Nat.ceil_lt_add_one (le_trans hd0pos.le ih)⟩
      obtain ⟨_, hg⟩ := epoch_gain hh hah ih hJm.1 hJm.2
      rw [← hdS m] at hg
      have hκ := kappa_pos hh hah
      have hJ0 : (0 : ℝ) ≤ J m := Nat.cast_nonneg _
      nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ (J m : ℝ) + 1) hκ.le]
  have hd0pos : 0 < h / (a - h) := div_pos hh h1
  have hJ : ∀ m, d m ≤ J m ∧ (J m : ℝ) < d m + 1 := fun m =>
    ⟨Nat.le_ceil _, Nat.ceil_lt_add_one (le_trans hd0pos.le (hdge m))⟩
  have hk1 : ∀ m, 1 ≤ k m := by
    intro m
    induction m with
    | zero => rw [hk0]
    | succ m ih => rw [hkS m]; omega
  -- the bound at the beginning of every epoch
  have hPk : ∀ m, P (k m) (h * (1 + 1 / d m)) := by
    intro m
    induction m with
    | zero =>
      rw [hk0, hd0]
      have e : h * (1 + 1 / (h / (a - h))) = a := by
        field_simp
        ring
      rw [e]
      exact hP1
    | succ m ih =>
      have hdm : 0 < d m := lt_of_lt_of_le hd0pos (hdge m)
      have hb : h < h * (1 + 1 / d m) := by
        have : 0 < 1 / d m := by positivity
        nlinarith
      have hceil : h / (h * (1 + 1 / d m) - h) = d m := by
        field_simp
        ring
      have key := hep (k m) (h * (1 + 1 / d m)) (hk1 m) ih hb
      rw [hceil] at key
      obtain ⟨hden, _⟩ := epoch_gain hh hah (hdge m) (hJ m).1 (hJ m).2
      have hJpos : (0 : ℝ) < J m := lt_of_lt_of_le hdm (hJ m).1
      have e : h * (1 + 1 / d m) * ((J m : ℝ) * a) / ((J m : ℝ) * a + h) = h * (1 + 1 / d (m + 1)) := by
        rw [hdS m]
        have hne1 : (J m : ℝ) * a - h * d m ≠ 0 := hden.ne'
        have hne2 : (J m : ℝ) * a + h ≠ 0 := by positivity
        have hne3 : d m ≠ 0 := hdm.ne'
        field_simp
        ring
      rw [hkS m]
      rw [← e]
      exact key
  -- persistence along levels
  have hpers : ∀ n n' b, 1 ≤ n → n ≤ n' → P n b → P n' b := by
    intro n n' b hn hnn' hP
    induction hnn' with
    | refl => exact hP
    | step hle ih => exact hstep _ b (le_trans hn hle) ih
  -- every level lies in an epoch
  have hkmono : ∀ m, m + 1 ≤ k m := by
    intro m
    induction m with
    | zero => rw [hk0]
    | succ m ih => rw [hkS m]; omega
  intro n hn
  have hex : ∃ m, n < k (m + 1) := ⟨n, by have := hkmono (n + 1); omega⟩
  classical
  set m := Nat.find hex with hmdef
  have hm : n < k (m + 1) := Nat.find_spec hex
  have hm' : k m ≤ n := by
    by_cases hm0 : m = 0
    · rw [hm0, hk0]; exact hn
    · obtain ⟨m', hm'⟩ := Nat.exists_eq_succ_of_ne_zero hm0
      have := Nat.find_min hex (m := m') (by omega)
      rw [not_lt] at this
      rw [hm']
      exact this
  have hdm : 0 < d m := lt_of_lt_of_le hd0pos (hdge m)
  have hcf := closed_form hh hah d k J hd0 hk0 hJ hdS hkS m n hm' hm
  refine hweak n _ _ (hpers (k m) n _ (hk1 m) hm' (hPk m)) ?_
  have e : h * (1 + 1 / d m) = h + h / d m := by
    field_simp
  rw [e]
  linarith

end ScienceR13


/-! ## The level recursion has the epoch property (Lemma 1, Lemma 2, "Epoch" of the proof), hence the rate (a) -/

namespace ScienceR13

open MetricChain.HintRecursion

variable {θna θh : ℝ → ℝ} {a h E : ℝ}

private theorem scale_aux' {p τ σ γ : ℝ} (hp : p ≠ 0) : p * (τ - σ * (γ / p)) = p * τ - σ * γ := by
  field_simp

/-- **Lemma 1 with `x₀ = ∞`** (`σ = 0`): a bound `T ≤ B` everywhere gives `T' g ≤ B − (B/h − 1) g` on `(0, h)`.
This is `StepLE.of_limit` at the outer fraction `φ = g/h`. -/
theorem lemma1_top (hp : HintPair θna θh a h E) {T T' : ℝ → ℝ} (hs : StepLE θna T T')
    (hanti : ∀ x y, 0 < x → x ≤ y → T y ≤ T x) {B : ℝ} (hT : ∀ x, 0 < x → T x ≤ B) :
    ∀ g, 0 < g → g < h → T' g ≤ B - (B / h - 1) * g := by
  intro g hg hgh
  have hh := hp.h_pos
  have hφ0 : 0 < g / h := div_pos hg hh
  have hφ1 : g / h < 1 := by rw [div_lt_one hh]; exact hgh
  have h1 : 0 < 1 - g / h := by linarith
  have hgφ : g / (g / h) = h := by field_simp
  have hμ : g / h * θna (g / (g / h)) = g := by
    rw [hgφ, hp.na_h]; exact div_mul_cancel₀ g hh.ne'
  apply StepLE.of_limit hs hanti hg hφ0 hφ1 (by rw [hgφ]; exact hp.na_cont h hh) (by rw [hμ]; exact hg)
  intro γ hγ0 hγ
  rw [hμ] at hγ
  have h2 := hT _ (div_pos hγ0 h1)
  have h3 := mul_le_mul_of_nonneg_left h2 h1.le
  have e : B - (B / h - 1) * g = g + (1 - g / h) * B := by field_simp; ring
  rw [e]
  linarith

/-- **Lemma 1** (the slope grows, the range shrinks harmonically). -/
theorem lemma1 (hp : HintPair θna θh a h E) {T T' : ℝ → ℝ} (hs : StepLE θna T T')
    (hanti : ∀ x y, 0 < x → x ≤ y → T y ≤ T x) {B σ x0 : ℝ} (hσ : σ ≤ 1) (hx0 : 0 < x0)
    (hT : ∀ x, 0 < x → x < x0 → T x ≤ B - σ * x) :
    ∀ g, 0 < g → g < x0 * h / (h + x0) → T' g ≤ B - (σ + B / h - 1) * g := by
  intro g hg hgx
  have hh := hp.h_pos
  have hsum : 0 < h + x0 := by linarith
  have hgx' : g * (h + x0) < x0 * h := by rwa [lt_div_iff₀ hsum] at hgx
  have hgh : g < h := by nlinarith
  have hφ0 : 0 < g / h := div_pos hg hh
  have hφ1 : g / h < 1 := by rw [div_lt_one hh]; exact hgh
  have h1 : 0 < 1 - g / h := by linarith
  have hgφ : g / (g / h) = h := by field_simp
  have hμ : g / h * θna (g / (g / h)) = g := by
    rw [hgφ, hp.na_h]; exact div_mul_cancel₀ g hh.ne'
  apply StepLE.of_limit hs hanti hg hφ0 hφ1 (by rw [hgφ]; exact hp.na_cont h hh) (by rw [hμ]; exact hg)
  intro γ hγ0 hγ
  rw [hμ] at hγ
  have hlt : γ / (1 - g / h) < x0 := by
    rw [div_lt_iff₀ h1]
    have e : x0 * (1 - g / h) = (x0 * h - x0 * g) / h := by field_simp
    have : g < x0 * (1 - g / h) := by
      rw [e, lt_div_iff₀ hh]
      nlinarith
    linarith
  have h2 := hT _ (div_pos hγ0 h1) hlt
  have h3 := mul_le_mul_of_nonneg_left h2 h1.le
  have h4 : (1 - g / h) * (B - σ * (γ / (1 - g / h))) = (1 - g / h) * B - σ * γ := scale_aux' h1.ne'
  rw [h4] at h3
  have e : B - (σ + B / h - 1) * g = (1 - σ) * g + (1 - g / h) * B := by field_simp; ring
  rw [e]
  have h5 : (1 - σ) * γ ≤ (1 - σ) * g := mul_le_mul_of_nonneg_left hγ (by linarith)
  linarith

/-- **Lemma 2** (the drop): slope one on `(0, x₀)` gives the factor `a/(a + x₀)` everywhere at the next level.
This is `StepLE.of_macro` with the outer fraction increasing to `x₀/(a + x₀)`. -/
theorem lemma2 (hp : HintPair θna θh a h E) {T T' : ℝ → ℝ} (hs : StepLE θna T T')
    (hanti : ∀ x y, 0 < x → x ≤ y → T y ≤ T x) {B x0 : ℝ} (hx0 : 0 < x0)
    (hT : ∀ x, 0 < x → x < x0 → T x ≤ B - x) :
    ∀ g, 0 < g → T' g ≤ B * a / (a + x0) := by
  intro g hg
  have ha := hp.a_pos
  have hax : 0 < a + x0 := by linarith
  have hφ : ∀ φ, 0 < φ → φ < x0 / (a + x0) → T' g ≤ (1 - φ) * B := by
    intro φ hφ0 hφlt
    have hφ1 : φ < 1 := lt_trans hφlt (by rw [div_lt_one hax]; linarith)
    have h1 : 0 < 1 - φ := by linarith
    apply StepLE.of_macro hp hs hanti hg hφ0 hφ1
    intro γ hγ0 hγ
    have hlt : γ / (1 - φ) < x0 := by
      rw [div_lt_iff₀ h1]
      have : φ * (a + x0) < x0 := by rwa [lt_div_iff₀ hax] at hφlt
      nlinarith
    have h2 := hT _ (div_pos hγ0 h1) hlt
    have h3 := mul_le_mul_of_nonneg_left h2 h1.le
    have h4 : (1 - φ) * (B - γ / (1 - φ)) = (1 - φ) * B - γ := by
      have hne : (1 - φ) ≠ 0 := h1.ne'
      field_simp
    rw [h4] at h3
    linarith
  have hφs0 : 0 < x0 / (a + x0) := div_pos hx0 hax
  have hlim : T' g ≤ (1 - x0 / (a + x0)) * B := by
    refine le_of_forall_pos_le_add fun ε hε => ?_
    obtain ⟨δ, hδ0, hδφ, hδB⟩ : ∃ δ : ℝ, 0 < δ ∧ δ < x0 / (a + x0) ∧ δ * |B| ≤ ε := by
      refine ⟨min (x0 / (a + x0) / 2) (ε / (|B| + 1)), lt_min (by linarith) (by positivity),
        lt_of_le_of_lt (min_le_left _ _) (by linarith), ?_⟩
      have h1 : min (x0 / (a + x0) / 2) (ε / (|B| + 1)) ≤ ε / (|B| + 1) := min_le_right _ _
      have h2 : ε / (|B| + 1) * |B| ≤ ε := by
        rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
        nlinarith [abs_nonneg B]
      calc min (x0 / (a + x0) / 2) (ε / (|B| + 1)) * |B| ≤ ε / (|B| + 1) * |B| :=
            mul_le_mul_of_nonneg_right h1 (abs_nonneg B)
        _ ≤ ε := h2
    have key := hφ (x0 / (a + x0) - δ) (by linarith) (by linarith)
    have e : (1 - (x0 / (a + x0) - δ)) * B = (1 - x0 / (a + x0)) * B + δ * B := by ring
    have hB : δ * B ≤ δ * |B| := mul_le_mul_of_nonneg_left (le_abs_self B) hδ0.le
    linarith
  have e : (1 - x0 / (a + x0)) * B = B * a / (a + x0) := by field_simp; ring
  rw [← e]
  exact hlim

/-- **Epoch.**  If `T n ≤ b` everywhere and `b > h`, then with `J = ⌈h/(b − h)⌉` the level `n + J + 1` is bounded by
`b J a/(J a + h)` everywhere: Lemma 1 `J` times, then Lemma 2. -/
theorem epoch_of_stepLE (hp : HintPair θna θh a h E) (T : ℕ → ℝ → ℝ)
    (hstep : ∀ k, StepLE θna (T k) (T (k + 1)))
    (hanti : ∀ k x y, 0 < x → x ≤ y → T k y ≤ T k x)
    {n : ℕ} {b : ℝ} (hb : h < b) (hTb : ∀ x, 0 < x → T n x ≤ b) :
    ∀ x, 0 < x → T (n + ⌈h / (b - h)⌉₊ + 1) x ≤
      b * ((⌈h / (b - h)⌉₊ : ℝ) * a) / ((⌈h / (b - h)⌉₊ : ℝ) * a + h) := by
  have hh := hp.h_pos
  have ha := hp.a_pos
  have hbh : 0 < b - h := by linarith
  have hdpos : 0 < h / (b - h) := div_pos hh hbh
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = b / h - 1 := ⟨_, rfl⟩
  have hc0 : 0 < c := by
    rw [hc]
    have : 1 < b / h := by rw [lt_div_iff₀ hh]; linarith
    linarith
  have hdc : h / (b - h) * c = 1 := by
    rw [hc]
    field_simp
  obtain ⟨J, hJ⟩ : ∃ J : ℕ, J = ⌈h / (b - h)⌉₊ := ⟨_, rfl⟩
  rw [← hJ]
  have hJ1 : h / (b - h) ≤ J := by rw [hJ]; exact Nat.le_ceil _
  have hJ2 : (J : ℝ) < h / (b - h) + 1 := by rw [hJ]; exact Nat.ceil_lt_add_one hdpos.le
  have hJr : (0 : ℝ) < J := lt_of_lt_of_le hdpos hJ1
  have hJpos : 1 ≤ J := by
    have : (0 : ℝ) < (J : ℝ) := hJr
    have : 0 < J := by exact_mod_cast this
    omega
  -- after j levels: slope j c on (0, h/j), for 1 ≤ j ≤ J
  have ind : ∀ j : ℕ, 1 ≤ j → j ≤ J → ∀ x, 0 < x → x < h / (j : ℝ) → T (n + j) x ≤ b - ((j : ℝ) * c) * x := by
    intro j hj1
    induction j, hj1 using Nat.le_induction with
    | base =>
      intro _ x hx hxh
      have hxh' : x < h := by simpa using hxh
      have key := lemma1_top hp (hstep n) (hanti n) hTb x hx hxh'
      rw [← hc] at key
      simpa using key
    | succ j hj ih =>
      intro hjJ x hx hxh
      have ihj := ih (by omega)
      have hjr : (0 : ℝ) < j := by exact_mod_cast hj
      have hσ : (j : ℝ) * c ≤ 1 := by
        have h1 : (j : ℝ) + 1 ≤ J := by exact_mod_cast hjJ
        have h2 : (j : ℝ) < h / (b - h) := by linarith
        nlinarith
      have hx0 : 0 < h / (j : ℝ) := div_pos hh hjr
      have e : h / (j : ℝ) * h / (h + h / (j : ℝ)) = h / ((j : ℝ) + 1) := by
        field_simp
      have hxh' : x < h / (j : ℝ) * h / (h + h / (j : ℝ)) := by
        rw [e]
        push_cast at hxh
        exact hxh
      have key := lemma1 hp (hstep (n + j)) (hanti (n + j)) hσ hx0 ihj x hx hxh'
      have e2 : b - ((j : ℝ) * c + b / h - 1) * x = b - (((j + 1 : ℕ) : ℝ) * c) * x := by
        push_cast
        rw [hc]
        ring
      rw [e2] at key
      exact key
  have hJc : 1 ≤ (J : ℝ) * c := by nlinarith
  have hslope : ∀ x, 0 < x → x < h / (J : ℝ) → T (n + J) x ≤ b - x := by
    intro x hx hxJ
    have h1 := ind J hJpos le_rfl x hx hxJ
    nlinarith
  have key := lemma2 hp (hstep (n + J)) (hanti (n + J)) (x0 := h / (J : ℝ)) (div_pos hh hJr) hslope
  intro x hx
  have h1 := key x hx
  have e : b * a / (a + h / (J : ℝ)) = b * ((J : ℝ) * a) / ((J : ℝ) * a + h) := by
    field_simp
  rw [← e]
  exact h1

/-- **Statement (a) of the rate, machine-checked.**  Let `(θna, θh, a, h, E)` be a `HintPair` with `h < a`, and let the
levels `T 1, T 2, …` be nonincreasing in the accuracy, nonincreasing in the level, with `T 1 ≤ a` and
`StepLE θna (T k) (T (k+1))`.  Then for every level `n ≥ 1` and every accuracy `x > 0`

  `T n x ≤ h + c₁/(n + c₂)`,   `c₁ = h (1 + κ)/κ`, `c₂ = (a + h)(2a − h)/(h a) − 2`, `κ = h² a/((a − h)(a + h)(2a − h))`. -/
theorem rate_top (hp : HintPair θna θh a h E) (hah : h < a) (T : ℕ → ℝ → ℝ)
    (hstep : ∀ k, StepLE θna (T k) (T (k + 1)))
    (hmono : ∀ k x, 0 < x → T (k + 1) x ≤ T k x)
    (hanti : ∀ k x y, 0 < x → x ≤ y → T k y ≤ T k x)
    (hbdd : ∀ x, 0 < x → T 1 x ≤ a) :
    ∀ n : ℕ, 1 ≤ n → ∀ x, 0 < x → T n x ≤ h + c1 a h / (n + c2 a h) :=
  rate_of_epochs hp.h_pos hah (fun n b => ∀ x, 0 < x → T n x ≤ b)
    (fun n _ _ hP x hx => (hmono n x hx).trans (hP x hx))
    (fun _ _ _ hP hbb' x hx => (hP x hx).trans hbb')
    hbdd
    (fun _ _ _ hP hb => epoch_of_stepLE hp T hstep hanti hb hP)

end ScienceR13


/-! ## Statement (a) with the levels numbered from zero, statement (b), and the exact recursion of the cube -/

namespace ScienceR13

open MetricChain.HintRecursion

variable {θna θh : ℝ → ℝ} {a h E : ℝ}

theorem c1_pos {a h : ℝ} (hh : 0 < h) (hah : h < a) : 0 < c1 a h := by
  unfold c1
  have hκ := kappa_pos hh hah
  positivity

theorem one_add_c2_pos {a h : ℝ} (hh : 0 < h) (hah : h < a) : 0 < 1 + c2 a h := by
  have hκ := kappa_pos hh hah
  have hκd := kappa_lt_d0 hh hah
  rw [c2_eq hh hah]
  have : 1 < h / (a - h) / kappa a h := by rw [lt_div_iff₀ hκ]; linarith
  linarith

/-- **Statement (a), levels numbered from zero** (`T 0` is `T₁` of the report, as for `exactRec`). -/
theorem rate_top0 (hp : HintPair θna θh a h E) (hah : h < a) (T : ℕ → ℝ → ℝ)
    (hstep : ∀ k, StepLE θna (T k) (T (k + 1)))
    (hmono : ∀ k x, 0 < x → T (k + 1) x ≤ T k x)
    (hanti : ∀ k x y, 0 < x → x ≤ y → T k y ≤ T k x)
    (hbdd : ∀ x, 0 < x → T 0 x ≤ a) :
    ∀ (n : ℕ) (x : ℝ), 0 < x → T n x ≤ h + c1 a h / (((n + 1 : ℕ) : ℝ) + c2 a h) := by
  have key := rate_of_epochs hp.h_pos hah (fun n b => ∀ x, 0 < x → T (n - 1) x ≤ b)
    (by
      intro n b hn hP x hx
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      have e : m + 1 + 1 - 1 = m + 1 := by omega
      have e' : m + 1 - 1 = m := by omega
      rw [e]
      rw [e'] at hP
      exact (hmono m x hx).trans (hP x hx))
    (fun _ _ _ hP hbb' x hx => (hP x hx).trans hbb')
    (by
      intro x hx
      exact hbdd x hx)
    (by
      intro n b hn hP hb x hx
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      have e' : m + 1 - 1 = m := by omega
      rw [e'] at hP
      have e : m + 1 + ⌈h / (b - h)⌉₊ + 1 - 1 = m + ⌈h / (b - h)⌉₊ + 1 := by omega
      rw [e]
      exact epoch_of_stepLE hp T hstep hanti hb hP x hx)
  intro n x hx
  have := key (n + 1) (by omega) x hx
  simpa using this

/-- **Statement (b) of the rate, machine-checked: every accuracy.**  With the constant `L ≥ 0` of `hint_lower`
(`θh e ≥ h − L e` on `(0, E)`; `L = 1` for the cube), for `0 < g < E`, `s = g + θh g` and
`A = max{c₁ + L s, (1 + c₂)(a − h + L g)}`: for every level `n` (numbered from zero) and every `0 < y ≤ g`,
`T n y − θh y ≤ A/(n + 1 + c₂)`. -/
theorem rate_all0 (hp : HintPair θna θh a h E) (hah : h < a) {L : ℝ} (hL0 : 0 ≤ L)
    (hLow : ∀ e, 0 < e → e < E → h - L * e ≤ θh e) (T : ℕ → ℝ → ℝ)
    (hstep : ∀ k, StepLE θna (T k) (T (k + 1)))
    (hmono : ∀ k x, 0 < x → T (k + 1) x ≤ T k x)
    (hanti : ∀ k x y, 0 < x → x ≤ y → T k y ≤ T k x)
    (hbdd : ∀ x, 0 < x → T 0 x ≤ a) {g : ℝ} (hg : 0 < g) (hgE : g < E) :
    ∀ (n : ℕ) (y : ℝ), 0 < y → y ≤ g →
      T n y - θh y ≤
        max (c1 a h + L * (g + θh g)) ((1 + c2 a h) * (a - h + L * g)) / (((n + 1 : ℕ) : ℝ) + c2 a h) := by
  have hh := hp.h_pos
  have hc1 := c1_pos hh hah
  have hc2 := one_add_c2_pos hh hah
  have hθg : 0 < θh g := hp.hint_pos g hg hgE
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = g + θh g := ⟨_, rfl⟩
  have hs0 : 0 < s := by rw [hs]; linarith
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = max (c1 a h + L * s) ((1 + c2 a h) * (a - h + L * g)) := ⟨_, rfl⟩
  rw [← hs, ← hA]
  have hA1 : c1 a h + L * s ≤ A := by rw [hA]; exact le_max_left _ _
  have hA2 : (1 + c2 a h) * (a - h + L * g) ≤ A := by rw [hA]; exact le_max_right _ _
  have hApos : 0 < A := by nlinarith [mul_nonneg hL0 hs0.le]
  have htop := rate_top0 hp hah T hstep hmono hanti hbdd
  intro n
  induction n with
  | zero =>
    intro y hy hyg
    have hyE : y < E := lt_of_le_of_lt hyg hgE
    have h1 := hbdd y hy
    have h2 := hLow y hy hyE
    have h3 : L * y ≤ L * g := mul_le_mul_of_nonneg_left hyg hL0
    have hden : ((0 + 1 : ℕ) : ℝ) + c2 a h = 1 + c2 a h := by push_cast; ring
    rw [hden, le_div_iff₀ hc2]
    have h4 : (T 0 y - θh y) * (1 + c2 a h) ≤ (a - h + L * g) * (1 + c2 a h) :=
      mul_le_mul_of_nonneg_right (by linarith) hc2.le
    linarith
  | succ n ih =>
    intro y hy hyg
    have hyE : y < E := lt_of_le_of_lt hyg hgE
    have hθy : 0 < θh y := hp.hint_pos y hy hyE
    have hsum : 0 < y + θh y := by linarith
    obtain ⟨K, hK⟩ : ∃ K : ℝ, K = ((n + 1 : ℕ) : ℝ) + c2 a h := ⟨_, rfl⟩
    have hKpos : 0 < K := by
      rw [hK]; push_cast
      have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
      linarith
    have hK1 : ((n + 1 + 1 : ℕ) : ℝ) + c2 a h = K + 1 := by rw [hK]; push_cast; ring
    rw [hK1]
    rw [← hK] at ih
    obtain ⟨m, hm⟩ : ∃ m : ℝ, m = A / K := ⟨_, rfl⟩
    rw [← hm] at ih
    have hm0 : 0 < m := by rw [hm]; positivity
    -- (L3) with C = y + θh y + m
    have hC : ∀ z, 0 < z → z ≤ y → z + T n z ≤ y + θh y + m := by
      intro z hz hzy
      have h1 := ih z hz (le_trans hzy hyg)
      have h2 := hp.hint_mono z y hz hzy hyE
      linarith
    have key := StepLE.at_hint_fraction hp (hstep n) (hanti n) hy hyE hC
    obtain ⟨v, hv⟩ : ∃ v : ℝ, v = T (n + 1) y - θh y := ⟨_, rfl⟩
    rw [← hv]
    -- first line: v s ≤ (s − y) m
    have hys : y + θh y ≤ s := by
      rw [hs]
      rcases eq_or_lt_of_le hyg with heq | hlt
      · rw [heq]
      · exact hp.hint_mono y g hy hyg hgE
    have hv1 : v * s ≤ (s - y) * m := by
      have e : θh y / (y + θh y) * (y + θh y + m) = θh y + θh y / (y + θh y) * m := by
        field_simp
      rw [e] at key
      have h1 : v ≤ θh y / (y + θh y) * m := by rw [hv]; linarith
      have h2 : θh y / (y + θh y) * s ≤ s - y := by
        rw [div_mul_eq_mul_div, div_le_iff₀ hsum]
        nlinarith
      calc v * s ≤ θh y / (y + θh y) * m * s := mul_le_mul_of_nonneg_right h1 hs0.le
        _ = θh y / (y + θh y) * s * m := by ring
        _ ≤ (s - y) * m := mul_le_mul_of_nonneg_right h2 hm0.le
    -- second line: v ≤ c₁/(K + 1) + L y
    have hv2 : v * (K + 1) ≤ c1 a h + (K + 1) * (L * y) := by
      have h1 := htop (n + 1) y hy
      rw [hK1] at h1
      have h2 := hLow y hy hyE
      have hK1pos : 0 < K + 1 := by linarith
      have h3 : v ≤ c1 a h / (K + 1) + L * y := by rw [hv]; linarith
      have h4 := mul_le_mul_of_nonneg_right h3 hK1pos.le
      have e : (c1 a h / (K + 1) + L * y) * (K + 1) = c1 a h + (K + 1) * (L * y) := by
        field_simp
      rw [e] at h4
      exact h4
    -- conclusion
    have hK1pos : 0 < K + 1 := by linarith
    rw [le_div_iff₀ hK1pos]
    have hv1' : K * (v * s) ≤ (s - y) * A := by
      have h1 := mul_le_mul_of_nonneg_left hv1 hKpos.le
      have e : K * ((s - y) * m) = (s - y) * A := by
        rw [hm]
        field_simp
      rw [e] at h1
      exact h1
    have hW : 0 < A + K * (L * s) := by
      have : 0 ≤ K * (L * s) := mul_nonneg hKpos.le (mul_nonneg hL0 hs0.le)
      linarith
    have T1 : v * (K + 1) * A ≤ (c1 a h + (K + 1) * (L * y)) * A := mul_le_mul_of_nonneg_right hv2 hApos.le
    have T2 : (K + 1) * L * (K * (v * s)) ≤ (K + 1) * L * ((s - y) * A) :=
      mul_le_mul_of_nonneg_left hv1' (mul_nonneg hK1pos.le hL0)
    have T3 : A * (c1 a h + L * s) ≤ A * A := mul_le_mul_of_nonneg_left hA1 hApos.le
    have hfin : v * (K + 1) * (A + K * (L * s)) ≤ A * (A + K * (L * s)) := by nlinarith
    exact le_of_mul_le_mul_right hfin hW

end ScienceR13

/-! ### The exact recursion of the cube: nothing assumed -/

namespace ScienceR13

open MetricChain.HintRecursion MetricChain.BoundedAccuracy Set

/-- **The rate for the exact level recursion of the cube** (`exactRec (cubeNa u) k` is `T_{k+1}` of the theory report):
for every slope `u > 0`, every level `k` and every accuracy rate `x > 0`,
`T_{k+1}(x) ≤ h + c₁/(k + 1 + c₂)` with `a = KL(p_u‖½)`, `h = KL(Λ₁/u‖½)`. -/
theorem cube_exactRec_rate_top {u : ℝ} (hu : 0 < u) (k : ℕ) {x : ℝ} (hx : 0 < x) :
    exactRec (cubeNa u) k x ≤
      cubeH u + c1 (cubeA u) (cubeH u) / (((k + 1 : ℕ) : ℝ) + c2 (cubeA u) (cubeH u)) := by
  have hθ : ∀ x, 0 < x → 0 ≤ cubeNa u x := fun x _ => cubeNa_nonneg u x
  have hθanti : ∀ x y, 0 < x → x ≤ y → cubeNa u y ≤ cubeNa u x := fun x y hx hxy =>
    cubeNa_antitoneOn hu (mem_Ici.mpr hx.le) (mem_Ici.mpr (hx.le.trans hxy)) hxy
  have hθC : ∀ x, 0 < x → cubeNa u x ≤ cubeA u := fun x hx => cubeNa_le_cubeA hu hx.le
  have P := fun k => exactRec_props hθ hθanti hθC k
  have hah : cubeH u < cubeA u := by
    have h1 := cubeHint_lt_cubeNa hu le_rfl (cubeEstar_pos hu)
    rw [cubeHint_zero, cubeNa_zero hu] at h1
    exact h1
  exact rate_top0 (cubePair hu) hah (exactRec (cubeNa u))
    (fun k => stepLE_exact hθ (P k).1)
    (fun k x _ => min_le_left _ _)
    (fun k x y hx hxy => (P k).2.2 x y hx hxy)
    (fun x hx => (P 0).2.1 x hx) k x hx

/-- **The rate at every accuracy for the exact level recursion of the cube** (`L = 1`): for `0 < g < ε*`,
`T_{k+1}(g) − θ_hint(g) ≤ A(g)/(k + 1 + c₂)`, `A(g) = max{c₁ + g + θ_hint(g), (1 + c₂)(a − h + g)}`. -/
theorem cube_exactRec_rate_all {u : ℝ} (hu : 0 < u) (k : ℕ) {g : ℝ} (hg : 0 < g) (hgE : g < cubeEstar u) :
    exactRec (cubeNa u) k g - cubeHint u g ≤
      max (c1 (cubeA u) (cubeH u) + (g + cubeHint u g)) ((1 + c2 (cubeA u) (cubeH u)) * (cubeA u - cubeH u + g)) /
        (((k + 1 : ℕ) : ℝ) + c2 (cubeA u) (cubeH u)) := by
  have hθ : ∀ x, 0 < x → 0 ≤ cubeNa u x := fun x _ => cubeNa_nonneg u x
  have hθanti : ∀ x y, 0 < x → x ≤ y → cubeNa u y ≤ cubeNa u x := fun x y hx hxy =>
    cubeNa_antitoneOn hu (mem_Ici.mpr hx.le) (mem_Ici.mpr (hx.le.trans hxy)) hxy
  have hθC : ∀ x, 0 < x → cubeNa u x ≤ cubeA u := fun x hx => cubeNa_le_cubeA hu hx.le
  have P := fun k => exactRec_props hθ hθanti hθC k
  have hah : cubeH u < cubeA u := by
    have h1 := cubeHint_lt_cubeNa hu le_rfl (cubeEstar_pos hu)
    rw [cubeHint_zero, cubeNa_zero hu] at h1
    exact h1
  have hLow : ∀ e, 0 < e → e < cubeEstar u → cubeH u - 1 * e ≤ cubeHint u e := by
    intro e he0 heE
    have h1 := cubeHint_add_mono hu le_rfl he0.le heE.le
    rw [zero_add, cubeHint_zero] at h1
    linarith
  have key := rate_all0 (cubePair hu) hah (L := 1) zero_le_one hLow (exactRec (cubeNa u))
    (fun k => stepLE_exact hθ (P k).1)
    (fun k x _ => min_le_left _ _)
    (fun k x y hx hxy => (P k).2.2 x y hx hxy)
    (fun x hx => (P 0).2.1 x hx) hg hgE k g hg le_rfl
  simpa using key

end ScienceR13


/-! ## The same rate at accuracy zero (Proposition R13.1): the quantitative form of `levels_reach_hint_at_zero` -/

namespace ScienceR13

open MetricChain.HintRecursion

variable {θna θh : ℝ → ℝ} {a h E : ℝ}

/-- A limit of upper bounds: if `t ≤ (1 − φ) b` for all `0 < φ < φs`, then `t ≤ (1 − φs) b`. -/
theorem le_of_forall_lt_frac {t b φs : ℝ} (hφs : 0 < φs) (hall : ∀ φ, 0 < φ → φ < φs → t ≤ (1 - φ) * b) :
    t ≤ (1 - φs) * b := by
  refine le_of_forall_pos_le_add fun ε hε => ?_
  obtain ⟨δ, hδ0, hδφ, hδB⟩ : ∃ δ : ℝ, 0 < δ ∧ δ < φs ∧ δ * |b| ≤ ε := by
    refine ⟨min (φs / 2) (ε / (|b| + 1)), lt_min (by linarith) (by positivity),
      lt_of_le_of_lt (min_le_left _ _) (by linarith), ?_⟩
    have h1 : min (φs / 2) (ε / (|b| + 1)) ≤ ε / (|b| + 1) := min_le_right _ _
    have h2 : ε / (|b| + 1) * |b| ≤ ε := by
      rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
      nlinarith [abs_nonneg b]
    calc min (φs / 2) (ε / (|b| + 1)) * |b| ≤ ε / (|b| + 1) * |b| :=
          mul_le_mul_of_nonneg_right h1 (abs_nonneg b)
      _ ≤ ε := h2
  have key := hall (φs - δ) (by linarith) (by linarith)
  have e : (1 - (φs - δ)) * b = (1 - φs) * b + δ * b := by ring
  have hB : δ * b ≤ δ * |b| := mul_le_mul_of_nonneg_left (le_abs_self b) hδ0.le
  linarith

/-- After `J = ⌈h/(b − h)⌉` levels above a level bounded by `b > h`, the slope is at least one on `(0, h/J)`
(Lemma 1 applied `J` times; the first half of `epoch_of_stepLE`). -/
theorem slope_of_stepLE (hp : HintPair θna θh a h E) (T : ℕ → ℝ → ℝ)
    (hstep : ∀ k, StepLE θna (T k) (T (k + 1)))
    (hanti : ∀ k x y, 0 < x → x ≤ y → T k y ≤ T k x)
    {n : ℕ} {b : ℝ} (hb : h < b) (hTb : ∀ x, 0 < x → T n x ≤ b) :
    ∀ x, 0 < x → x < h / (⌈h / (b - h)⌉₊ : ℝ) → T (n + ⌈h / (b - h)⌉₊) x ≤ b - x := by
  have hh := hp.h_pos
  have hbh : 0 < b - h := by linarith
  have hdpos : 0 < h / (b - h) := div_pos hh hbh
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = b / h - 1 := ⟨_, rfl⟩
  have hc0 : 0 < c := by
    rw [hc]
    have : 1 < b / h := by rw [lt_div_iff₀ hh]; linarith
    linarith
  have hdc : h / (b - h) * c = 1 := by
    rw [hc]
    field_simp
  obtain ⟨J, hJ⟩ : ∃ J : ℕ, J = ⌈h / (b - h)⌉₊ := ⟨_, rfl⟩
  rw [← hJ]
  have hJ1 : h / (b - h) ≤ J := by rw [hJ]; exact Nat.le_ceil _
  have hJr : (0 : ℝ) < J := lt_of_lt_of_le hdpos hJ1
  have hJpos : 1 ≤ J := by
    have : 0 < J := by exact_mod_cast hJr
    omega
  have ind : ∀ j : ℕ, 1 ≤ j → j ≤ J → ∀ x, 0 < x → x < h / (j : ℝ) → T (n + j) x ≤ b - ((j : ℝ) * c) * x := by
    intro j hj1
    induction j, hj1 using Nat.le_induction with
    | base =>
      intro _ x hx hxh
      have hxh' : x < h := by simpa using hxh
      have key := lemma1_top hp (hstep n) (hanti n) hTb x hx hxh'
      rw [← hc] at key
      simpa using key
    | succ j hj ih =>
      intro hjJ x hx hxh
      have ihj := ih (by omega)
      have hjr : (0 : ℝ) < j := by exact_mod_cast hj
      have hσ : (j : ℝ) * c ≤ 1 := by
        have h1 : (j : ℝ) + 1 ≤ J := by exact_mod_cast hjJ
        have hJ2 : (J : ℝ) < h / (b - h) + 1 := by rw [hJ]; exact Nat.ceil_lt_add_one hdpos.le
        have h2 : (j : ℝ) < h / (b - h) := by linarith
        nlinarith
      have hx0 : 0 < h / (j : ℝ) := div_pos hh hjr
      have e : h / (j : ℝ) * h / (h + h / (j : ℝ)) = h / ((j : ℝ) + 1) := by
        field_simp
      have hxh' : x < h / (j : ℝ) * h / (h + h / (j : ℝ)) := by
        rw [e]
        push_cast at hxh
        exact hxh
      have key := lemma1 hp (hstep (n + j)) (hanti (n + j)) hσ hx0 ihj x hx hxh'
      have e2 : b - ((j : ℝ) * c + b / h - 1) * x = b - (((j + 1 : ℕ) : ℝ) * c) * x := by
        push_cast
        rw [hc]
        ring
      rw [e2] at key
      exact key
  have hJc : 1 ≤ (J : ℝ) * c := by nlinarith
  intro x hx hxJ
  have h1 := ind J hJpos le_rfl x hx hxJ
  nlinarith

/-- **The rate at accuracy zero** (Proposition R13.1 of the workstream report).  Besides the levels `T k` of
`rate_top0`, let `τ k` obey the one-level bound at accuracy zero for every outer fraction — the hypothesis `hstep0`
of `MetricChain.BoundedAccuracy.levels_reach_hint_at_zero` — with `τ 0 ≤ a`.  Then
`τ n ≤ h + c₁/(n + 1 + c₂)` for every `n`: the quantitative form of that theorem. -/
theorem rate_zero (hp : HintPair θna θh a h E) (hah : h < a) (T : ℕ → ℝ → ℝ) (τ : ℕ → ℝ)
    (hstep : ∀ k, StepLE θna (T k) (T (k + 1)))
    (hmono : ∀ k x, 0 < x → T (k + 1) x ≤ T k x)
    (hanti : ∀ k x y, 0 < x → x ≤ y → T k y ≤ T k x)
    (hbdd : ∀ x, 0 < x → T 0 x ≤ a) (hτ0 : τ 0 ≤ a)
    (hstep0 : ∀ k φ B, 0 < φ → φ < 1 → (1 - φ) * τ k ≤ B →
      (∀ γ, 0 < γ → γ ≤ φ * a → γ + (1 - φ) * T k (γ / (1 - φ)) ≤ B) → τ (k + 1) ≤ B) :
    ∀ n : ℕ, τ n ≤ h + c1 a h / (((n + 1 : ℕ) : ℝ) + c2 a h) := by
  have hh := hp.h_pos
  have ha := hp.a_pos
  -- one level keeps a common bound
  have pers : ∀ m b, τ m ≤ b → (∀ x, 0 < x → T m x ≤ b) → τ (m + 1) ≤ b := by
    intro m b hτb hTb
    have hall : ∀ φ, 0 < φ → φ < 1 → τ (m + 1) ≤ (1 - φ) * b + φ * a := by
      intro φ hφ0 hφ1
      have h1 : 0 < 1 - φ := by linarith
      apply hstep0 m φ _ hφ0 hφ1
      · have := mul_le_mul_of_nonneg_left hτb h1.le
        nlinarith
      · intro γ hγ0 hγ
        have h2 := hTb _ (div_pos hγ0 h1)
        have h3 := mul_le_mul_of_nonneg_left h2 h1.le
        linarith
    refine le_of_forall_pos_le_add fun ε hε => ?_
    obtain ⟨φ, hφ0, hφ1, hφε⟩ : ∃ φ : ℝ, 0 < φ ∧ φ < 1 ∧ φ * |a - b| ≤ ε := by
      refine ⟨min (1 / 2) (ε / (|a - b| + 1)), lt_min (by norm_num) (by positivity),
        lt_of_le_of_lt (min_le_left _ _) (by norm_num), ?_⟩
      have h1 : min (1 / 2) (ε / (|a - b| + 1)) ≤ ε / (|a - b| + 1) := min_le_right _ _
      have h2 : ε / (|a - b| + 1) * |a - b| ≤ ε := by
        rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
        nlinarith [abs_nonneg (a - b)]
      calc min (1 / 2) (ε / (|a - b| + 1)) * |a - b| ≤ ε / (|a - b| + 1) * |a - b| :=
            mul_le_mul_of_nonneg_right h1 (abs_nonneg _)
        _ ≤ ε := h2
    have key := hall φ hφ0 hφ1
    have e : (1 - φ) * b + φ * a = b + φ * (a - b) := by ring
    have hB : φ * (a - b) ≤ φ * |a - b| := mul_le_mul_of_nonneg_left (le_abs_self _) hφ0.le
    linarith
  have key := rate_of_epochs hh hah (fun n b => τ (n - 1) ≤ b ∧ ∀ x, 0 < x → T (n - 1) x ≤ b)
    (by
      intro n b hn hP
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      have e : m + 1 + 1 - 1 = m + 1 := by omega
      have e' : m + 1 - 1 = m := by omega
      rw [e]
      rw [e'] at hP
      exact ⟨pers m b hP.1 hP.2, fun x hx => (hmono m x hx).trans (hP.2 x hx)⟩)
    (fun _ _ _ hP hbb' => ⟨hP.1.trans hbb', fun x hx => (hP.2 x hx).trans hbb'⟩)
    ⟨hτ0, hbdd⟩
    (by
      intro n b hn hP hb
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      have e' : m + 1 - 1 = m := by omega
      rw [e'] at hP
      have e : m + 1 + ⌈h / (b - h)⌉₊ + 1 - 1 = m + ⌈h / (b - h)⌉₊ + 1 := by omega
      rw [e]
      refine ⟨?_, epoch_of_stepLE hp T hstep hanti hb hP.2⟩
      -- the common bound persists for J levels
      have hbh : 0 < b - h := by linarith
      have hdpos : 0 < h / (b - h) := div_pos hh hbh
      have hslope := slope_of_stepLE hp T hstep hanti hb hP.2
      obtain ⟨J, hJ⟩ : ∃ J : ℕ, J = ⌈h / (b - h)⌉₊ := ⟨_, rfl⟩
      rw [← hJ] at hslope ⊢
      have hJr : (0 : ℝ) < J := lt_of_lt_of_le hdpos (by rw [hJ]; exact Nat.le_ceil _)
      have hboth : ∀ j : ℕ, τ (m + j) ≤ b ∧ ∀ x, 0 < x → T (m + j) x ≤ b := by
        intro j
        induction j with
        | zero => exact hP
        | succ j ih => exact ⟨pers (m + j) b ih.1 ih.2, fun x hx => (hmono (m + j) x hx).trans (ih.2 x hx)⟩
      have hx0 : 0 < h / (J : ℝ) := div_pos hh hJr
      have hax : 0 < a + h / (J : ℝ) := by linarith
      have hφs0 : 0 < h / (J : ℝ) / (a + h / (J : ℝ)) := div_pos hx0 hax
      have hall : ∀ φ, 0 < φ → φ < h / (J : ℝ) / (a + h / (J : ℝ)) → τ (m + J + 1) ≤ (1 - φ) * b := by
        intro φ hφ0 hφlt
        have hφ1 : φ < 1 := lt_trans hφlt (by rw [div_lt_one hax]; linarith)
        have h1 : 0 < 1 - φ := by linarith
        apply hstep0 (m + J) φ _ hφ0 hφ1
        · exact mul_le_mul_of_nonneg_left (hboth J).1 h1.le
        · intro γ hγ0 hγ
          have hlt : γ / (1 - φ) < h / (J : ℝ) := by
            rw [div_lt_iff₀ h1]
            have : φ * (a + h / (J : ℝ)) < h / (J : ℝ) := by rwa [lt_div_iff₀ hax] at hφlt
            nlinarith
          have h2 := hslope _ (div_pos hγ0 h1) hlt
          have h3 := mul_le_mul_of_nonneg_left h2 h1.le
          have h4 : (1 - φ) * (b - γ / (1 - φ)) = (1 - φ) * b - γ := by
            have hne : (1 - φ) ≠ 0 := h1.ne'
            field_simp
          rw [h4] at h3
          linarith
      have hlim := le_of_forall_lt_frac hφs0 hall
      have e2 : (1 - h / (J : ℝ) / (a + h / (J : ℝ))) * b = b * ((J : ℝ) * a) / ((J : ℝ) * a + h) := by
        field_simp
        ring
      rw [← e2]
      exact hlim)
  intro n
  have := (key (n + 1) (by omega)).1
  simpa using this

end ScienceR13
