@ScienceR13.rate_all0 : ∀ {θna θh : ℝ → ℝ} {a h E : ℝ},
  MetricChain.HintRecursion.HintPair θna θh a h E →
    h < a →
      ∀ {L : ℝ},
        0 ≤ L →
          (∀ (e : ℝ), 0 < e → e < E → h - L * e ≤ θh e) →
            ∀ (T : ℕ → ℝ → ℝ),
              (∀ (k : ℕ), MetricChain.HintRecursion.StepLE θna (T k) (T (k + 1))) →
