        (∀ (k : ℕ), MetricChain.HintRecursion.StepLE θna (T k) (T (k + 1))) →
          (∀ (k : ℕ) (x : ℝ), 0 < x → T (k + 1) x ≤ T k x) →
            (∀ (k : ℕ) (x y : ℝ), 0 < x → x ≤ y → T k y ≤ T k x) →
              (∀ (x : ℝ), 0 < x → T 0 x ≤ a) →
                τ 0 ≤ a →
                  (∀ (k : ℕ) (φ B : ℝ),
                      0 < φ →
                        φ < 1 →
                          (1 - φ) * τ k ≤ B →
                            (∀ (γ : ℝ), 0 < γ → γ ≤ φ * a → γ + (1 - φ) * T k (γ / (1 - φ)) ≤ B) → τ (k + 1) ≤ B) →
